# ==============================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - SIMPLETRON BOT
# ==============================================================
# Copie este arquivo para .env e preencha com seus próprios dados:
#   cp .env.example .env
# ==============================================================

# [OBRIGATÓRIO] Token secreto do Bot gerado no Discord Developer Portal.
# Obtenha em: https://discord.com/developers/applications > Seu Bot > Bot > Reset Token
DISCORD_BOT_TOKEN="seu_token_aqui_sem_aspas"

# [OBRIGATÓRIO] ID numérico do Servidor (Guild ID) para sincronização instantânea dos Slash Commands.
# Obtenha ativando o Modo Desenvolvedor no Discord > Clique com botão direito no ícone do servidor > Copiar ID
DISCORD_GUILD_ID=0000000000000000000

# [OPCIONAL] Chave da API do Google Gemini para comandos de IA (/perguntar e menções).
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=""

# [OPCIONAL] Modelo do Google Gemini a ser utilizado (padrão: gemini-flash-latest)
# Exemplos: gemini-flash-latest, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-flash-latest"
